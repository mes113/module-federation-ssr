{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src/**/*.ts", "src/**/*.tsx", "rsbuild.config.ts"],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "paths": {
      "tanstack_rsbuild_ssr_remote/*": ["./@mf-types/tanstack_rsbuild_ssr_remote/*"],
      "tanstack_rsbuild_cart/*": ["./@mf-types/tanstack_rsbuild_cart/*"]
    }
  }
}
